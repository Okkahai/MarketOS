# MarketOS configuration. Copy to .env and fill in what you have.
# Never commit .env. Every key is optional in Phase 1; a provider without a key
# is shown as "no key" and its jobs are skipped, never faked.

# --- App ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# the only accepted value; real trading does not exist
TRADING_MODE=paper
CORS_ORIGINS=http://localhost:3000
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Database and cache (docker compose builds the URLs from these) ------------
POSTGRES_USER=marketos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketos
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://marketos:change-me@localhost:5432/marketos
REDIS_URL=redis://localhost:6379/0

# --- Paper trading -------------------------------------------------------------
# decimal string, in BASE_CURRENCY
PAPER_INITIAL_CAPITAL=10000
BASE_CURRENCY=USD
# Risk rules (see docs/ARCHITECTURE.md section 9). Percentages are of total portfolio value.
PAPER_MIN_CONFIDENCE=0.60
PAPER_STRONG_BUY_MIN_CONFIDENCE=0.75
PAPER_MAX_POSITION_PCT=10
PAPER_MAX_SECTOR_PCT=30
PAPER_MAX_CRYPTO_PCT=25
PAPER_MIN_CASH_PCT=10
PAPER_MAX_OPEN_POSITIONS=8
PAPER_MIN_TRADE_USD=50
PAPER_DEFAULT_POSITION_PCT=4
PAPER_COOLDOWN_HOURS=24
PAPER_MAX_TRADES_PER_DAY=5
PAPER_DEFAULT_STOP_PCT=8
PAPER_MAX_STOP_PCT=10
PAPER_MAX_TAKE_PROFIT_PCT=30
PAPER_DRAWDOWN_BREAKER_PCT=20
# Simulated execution costs, in basis points; orders expire if no price arrives in time.
PAPER_SLIPPAGE_BPS_STOCK=5
PAPER_SLIPPAGE_BPS_CRYPTO=10
PAPER_FEE_BPS_STOCK=0
PAPER_FEE_BPS_CRYPTO=40
PAPER_MIN_FEE=0
PAPER_ORDER_EXPIRY_HOURS=72
PAPER_CRYPTO_FILL_INTERVAL=1m

# --- Schedules (seconds) ---------------------------------------------------------
SCHEDULE_HEARTBEAT_SECONDS=60
SCHEDULE_STOCK_DAILY_SECONDS=3600
SCHEDULE_CRYPTO_DAILY_SECONDS=3600
SCHEDULE_CRYPTO_1M_SECONDS=60
SCHEDULE_INDICATORS_SECONDS=3600
SCHEDULE_NEWS_SECONDS=900
SCHEDULE_EVENTS_SECONDS=600
EVENT_WINDOW_HOURS=48
NEWS_BACKFILL_DAYS=3
NEWS_DEDUP_WINDOW_HOURS=48

# --- Market data collection ------------------------------------------------------
# Daily bars fetched on the first run, and hours of 1-minute bars.
MARKET_HISTORY_DAYS=400
MARKET_INTRADAY_BACKFILL_HOURS=24
# Days re-fetched on every run so provider corrections are caught.
MARKET_OVERLAP_DAYS=5
# Newest indicator values kept per asset.
INDICATOR_STORE_BARS=30
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=3
# Kept under Tiingo's free-tier limit of 50 requests/hour.
TIINGO_MAX_REQUESTS_PER_HOUR=40

# --- Market data providers (Phase 2) -------------------------------------------
# Tiingo: stocks + news. Free plan is personal use only. https://www.tiingo.com/about/pricing
TIINGO_API_KEY=
# Alpha Vantage: stock fallback, 25 requests/day free. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# CoinGecko Demo: crypto fallback, attribution required. https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
# Coinbase Exchange public market data needs no key.

# --- News and macro providers (Phase 3) ------------------------------------------
# SEC EDGAR requires a User-Agent with your name and contact email.
SEC_USER_AGENT=
# FRED / ALFRED macro data. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub (optional second news source), personal use only.
FINNHUB_API_KEY=

# --- AI (Phase 5) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Per-million-token prices (USD) for each model in use. A model without a price is never called.
# Copy them from your provider's pricing page; MarketOS does not guess them.
# AI_MODEL_PRICES={"claude-haiku-4-5-20251001":{"input":"1","output":"5"}}
AI_TRIAGE_MODEL=claude-haiku-4-5-20251001
AI_ANALYSIS_MODEL=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=5
AI_MIN_EVENT_IMPORTANCE=0.3
AI_MAX_EVENTS_PER_RUN=5
AI_REANALYZE_HOURS=6
AI_MAX_SIGNALS_PER_ANALYSIS=3
SCHEDULE_AI_SECONDS=900
SCHEDULE_PAPER_SECONDS=300
SCHEDULE_RECONCILE_SECONDS=3600
SCHEDULE_EVALUATE_SECONDS=3600
